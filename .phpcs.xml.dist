<?xml version="1.0"?>
<ruleset name="Static Export WP">
	<description>PHP Coding Standards for Static Export WP</description>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<file>./src</file>
	<file>./static-export-wp.php</file>
	<file>./uninstall.php</file>

	<exclude-pattern>./vendor/*</exclude-pattern>
	<exclude-pattern>./node_modules/*</exclude-pattern>
	<exclude-pattern>./build/*</exclude-pattern>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>

		<!--
		The plugin owns three custom tables (sewp_crawl_queue, sewp_export_log,
		sewp_content_hashes) that aren't part of WP core schema. All access to
		them necessarily goes through $wpdb directly; there is no WP core API
		to wrap it in, and caching individual queue-status reads would be
		actively wrong since the data changes on every request during a crawl.
		-->
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>

		<!--
		exec()/shell_exec() (CommandDeployer, GitDeployer) and direct
		filesystem calls (GitDeployer's bare-repo cleanup, NetlifyDeployer's
		local file reads, AdminPage's ZIP download) are deliberate, admin-only
		(manage_options-gated) features documented inline at each call site;
		not something WP_Filesystem or wp_remote_get() can replace here.
		-->
		<exclude name="WordPress.PHP.DiscouragedPHPFunctions.system_calls_exec"/>
		<exclude name="WordPress.PHP.DiscouragedPHPFunctions.system_calls_shell_exec"/>
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents"/>
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_rmdir"/>
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_readfile"/>
		<exclude name="WordPress.WP.AlternativeFunctions.unlink_unlink"/>
		<exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>

		<!-- Logger's entire purpose is writing to the PHP error log. -->
		<exclude name="WordPress.PHP.DevelopmentFunctions.error_log_error_log"/>

		<!--
		Flagged params are required by an external signature the plugin must
		match (a WP-CLI command's $args/$assoc_args, a progress-callback's
		$current_url) even when unused at a given call site.
		-->
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="static-export-wp"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="6.4"/>
</ruleset>
